sudo tee /etc/httpd/conf.d/cp-repo.conf >/dev/null <<'EOF'
# Managed by cpctl - internal repository, HTTPS only (plain HTTP answers 403)
DocumentRoot "/srv/repo"
<Directory "/srv/repo">
    Require all denied
</Directory>

Listen 8443 https
