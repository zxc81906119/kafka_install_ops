$ rm_and_install() {  # <host> <8.2.4 packages...>
  local h=$1; shift
  ssh $h.poc.lab "PKGS='$*' bash -s" <<'EOS'
set -e
sudo dnf versionlock delete $(rpm -qa --qf '%{NAME}\n' 'confluent-*') >/dev/null 2>&1 || true
old=$(rpm -qa --qf '%{NAME}\n' 'confluent-*'); [ -z "$old" ] || sudo dnf -y -q remove $old >/dev/null
sudo dnf -y -q --refresh --disablerepo='*' --enablerepo='cp-internal-*' --setopt=install_weak_deps=False install $PKGS >/dev/null
for p in $(rpm -qa --qf '%{NAME}-%{VERSION}-%{RELEASE}\n' 'confluent-*'); do sudo dnf -q versionlock add "$p" >/dev/null; done
[ -d /var/lib/kafka/data ] && sudo find /var/lib/kafka/data -mindepth 1 -delete
echo "$(hostname): $(rpm -q --qf '%{NAME}-%{VERSION} ' confluent-server confluent-kafka-rest 2>/dev/null | grep -o 'confluent-[a-z-]*-8[.0-9]*' | tr '\n' ' ') locks=$(sudo dnf -q versionlock list | grep -c confluent)"
EOS
}
for h in kc01 kc02 kc03 kb01 kb02 kb03 kb04; do rm_and_install $h confluent-server-8.2.4 confluent-security-8.2.4; done
for h in rest01 rest02; do rm_and_install $h confluent-kafka-rest-8.2.4 confluent-security-8.2.4; done

