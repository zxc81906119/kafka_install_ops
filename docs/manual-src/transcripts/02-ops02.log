##### 8.1 REST、C3 重新啟動(連到全新的 8.2.4 叢集)

$ . ~/manual.env
for h in rest01 rest02; do ssh $h.poc.lab "sudo systemctl start confluent-kafka-rest"; done
ssh c3-01.poc.lab 'for u in prometheus alertmanager confluent-control-center; do sudo systemctl start --no-block $u; done'
for i in $(seq 1 36); do c=$(curl -s -o /dev/null -w '%{http_code}' --cacert $PKI/ca.pem --cert $PKI/app-legacy-billing.crt --key $PKI/app-legacy-billing.key https://rest.poc.lab:8082/v3/clusters); [ "$c" = 200 ] && break; sleep 5; done; echo "REST via LB: $c"
for i in $(seq 1 84); do c=$(curl -s -o /dev/null -w '%{http_code}' --cacert $PKI/ca.pem https://c3.poc.lab:9021/); [ "$c" = 200 ] && break; sleep 5; done; echo "C3 via LB: $c"
for h in kb01 rest01; do ssh $h.poc.lab "rpm -q confluent-server confluent-kafka-rest 2>/dev/null | grep -v 'not installed'"; done

