##### 8.1 重做 08(SCRAM、RBAC、topic)與 6.9(break-glass 綁定)

$ . ~/manual.env; set -a; . $S/secrets.env; set +a
 kafka-configs --bootstrap-server "$B" --command-config "$CFG" --alter --entity-type users --entity-name app-orders --add-config "SCRAM-SHA-512=[iterations=8192,password=$APP_APP_ORDERS_PASSWORD]" >/dev/null
 kafka-configs --bootstrap-server "$B" --command-config "$CFG" --alter --entity-type users --entity-name app-payments --add-config "SCRAM-SHA-512=[iterations=8192,password=$APP_APP_PAYMENTS_PASSWORD]" >/dev/null
for i in $(seq 1 24); do HOME=$S/cli-home CONFLUENT_PLATFORM_USERNAME=svc-cpctl CONFLUENT_PLATFORM_PASSWORD="$SVC_CPCTL_PASSWORD" confluent login --url https://kb01.poc.lab:8090 --certificate-authority-path $PKI/ca.pem >/dev/null 2>&1 && break; sleep 5; done; echo "mds login after ~$((i*5))s"
rb() { HOME=$S/cli-home confluent iam rbac role-binding create --kafka-cluster $CID "$@" -o json >/dev/null && echo -n "." || echo "FAIL $*"; }
rb --principal User:confluent-audit --role DeveloperWrite  --resource Topic:confluent-audit-log-events --prefix
