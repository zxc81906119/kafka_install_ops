OLD=$(ls -d $PKI/archive/*-app-legacy-billing | tail -1)
echo "old-CA app cert from archive: $(openssl x509 -in $OLD/app-legacy-billing.crt -noout -issuer | sed 's/.*CN=\([^,]*\).*/\1/')"
curl -s -o /dev/null -w "REST with the OLD-CA app certificate: %{http_code} exit=%{exitcode}\n" --cacert $PKI/ca.pem --cert $OLD/app-legacy-billing.crt --key $OLD/app-legacy-billing.key https://rest.poc.lab:8082/v3/clusters
curl -s -o /dev/null -w "REST with the NEW app certificate:    %{http_code}\n" --cacert $PKI/ca.pem --cert $PKI/app-legacy-billing.crt --key $PKI/app-legacy-billing.key https://rest.poc.lab:8082/v3/clusters

