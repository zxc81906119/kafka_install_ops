##### 8.1 重做 08(SCRAM、RBAC、topic)與 6.9(break-glass 綁定)

$ . ~/manual.env; set -a; . $S/secrets.env; set +a
 kafka-configs --bootstrap-server "$B" --command-config "$CFG" --alter --entity-type users --entity-name app-orders --add-config "SCRAM-SHA-512=[iterations=8192,password=$APP_APP_ORDERS_PASSWORD]" >/dev/null
 kafka-configs --bootstrap-server "$B" --command-config "$CFG" --alter --entity-type users --entity-name app-payments --add-config "SCRAM-SHA-512=[iterations=8192,password=$APP_APP_PAYMENTS_PASSWORD]" >/dev/null
for i in $(seq 1 24); do HOME=$S/cli-home CONFLUENT_PLATFORM_USERNAME=svc-cpctl CONFLUENT_PLATFORM_PASSWORD="$SVC_CPCTL_PASSWORD" confluent login --url https://kb01.poc.lab:8090 --certificate-authority-path $PKI/ca.pem >/dev/null 2>&1 && break; sleep 5; done; echo "mds login after ~$((i*5))s"
rb() { HOME=$S/cli-home confluent iam rbac role-binding create --kafka-cluster $CID "$@" -o json >/dev/null && echo -n "." || echo "FAIL $*"; }
rb --principal User:confluent-audit --role DeveloperWrite  --resource Topic:confluent-audit-log-events --prefix
rb --principal User:confluent-audit --role DeveloperManage --resource Topic:confluent-audit-log-events --prefix
rb --principal User:svc-c3 --role SystemAdmin
rb --principal User:svc-rest --role DeveloperRead --resource Topic:_confluent-license
rb --principal User:svc-rest --role DeveloperRead --resource Topic:_confluent-command
rb --principal User:svc-rest --role DeveloperRead --resource Topic:__internal_confluent_only_broker_info
rb --principal Group:kafka-admins    --role SystemAdmin
rb --principal Group:kafka-operators --role Operator
rb --principal Group:kafka-devs --role DeveloperRead --resource Topic:orders. --prefix
rb --principal Group:kafka-devs --role DeveloperRead --resource Group:dev- --prefix
rb --principal User:app-orders --role DeveloperWrite  --resource Topic:orders. --prefix
rb --principal User:app-orders --role DeveloperRead   --resource Topic:orders. --prefix
rb --principal User:app-orders --role DeveloperRead   --resource Group:orders- --prefix
rb --principal User:app-orders --role DeveloperManage --resource Topic:orders. --prefix
rb --principal User:app-payments --role DeveloperWrite --resource Topic:payments. --prefix
rb --principal User:app-payments --role DeveloperRead  --resource Topic:payments. --prefix
rb --principal User:app-legacy-billing --role DeveloperWrite --resource Topic:billing. --prefix
rb --principal User:app-legacy-billing --role DeveloperRead  --resource Topic:billing. --prefix
rb --principal User:app-legacy-billing --role DeveloperRead  --resource Group:billing- --prefix
rb --principal User:opmenu-breakglass --role SystemAdmin
echo " bindings done"
for t in orders.events:6 payments.events:6 billing.events:3; do kafka-topics --bootstrap-server "$B" --command-config "$CFG" --create --if-not-exists --topic "${t%%:*}" --partitions "${t#*:}" --replication-factor 3 --config min.insync.replicas=2 2>&1 | grep -v WARNING; done

