##### 8.1 格式化(沿用 kraft.env 的 cluster id / directory id;資料已清空)、啟動

$ . ~/manual.env; set -a; . $S/secrets.env; . $S/kraft.env; set +a
INITIAL="1@kc01.poc.lab:9093:$DIR_ID_kc01,2@kc02.poc.lab:9093:$DIR_ID_kc02,3@kc03.poc.lab:9093:$DIR_ID_kc03"
for h in kc01 kc02 kc03; do
  ssh $h.poc.lab "sudo bash -c \"set -a; . /etc/confluent/kafka/service.env; set +a; sudo -u cp-kafka --preserve-env=CONFLUENT_SECURITY_MASTER_KEY env JAVA_HOME=/usr/lib/jvm/temurin-21-jdk KAFKA_HEAP_OPTS=-Xmx256m KAFKA_OPTS=-Dlog4j2.configurationFile=/etc/kafka/tools-log4j2.yaml /usr/bin/kafka-storage format --cluster-id $CLUSTER_ID --config /etc/confluent/kafka/server.properties --initial-controllers '$INITIAL' --add-scram 'SCRAM-SHA-512=[name=kafka-admin,password=$KAFKA_ADMIN_PASSWORD]' --add-scram 'SCRAM-SHA-512=[name=confluent-audit,password=$AUDIT_PASSWORD]' | grep -vi scram | tail -1\""
done
