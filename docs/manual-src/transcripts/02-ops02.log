##### 5.2.1 REST Proxy:設定(完整版)→ 加密 → 派送 → JMX exporter → drop-in → 啟動

$ . ~/manual.env; . ~/encrypt.sh; set -a; . $S/secrets.env; set +a
G=/var/lib/cp-installer/manual/gen-edge-properties.sh
bash $G rest rest01 rest-01; bash $G rest rest02 rest-02
SALT=$(cat $S/jmx-exporter.salt); HASH=$(printf '%s:%s' "$SALT" "$JMX_EXPORTER_PASSWORD" | sha256sum | awk '{print $1}')
for H in rest01 rest02; do
  D=$S/secret-protection/$H
  encrypt $D $D/kafka-rest.properties /etc/confluent/kafka-rest/security.properties
  ( umask 077; printf 'CONFLUENT_SECURITY_MASTER_KEY=%s\n' "$(cat $S/secret-protection/master.key)" > $D/service.env
