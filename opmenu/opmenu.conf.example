# opmenu.conf.example — 正式環境(操作機 + RHEL 9 主機)的設定範本。複製成 /etc/opmenu/opmenu.conf 後填入實際值。
# 只需要填「無法推算」的值;沒有列在這裡的項目,用 lib/defaults.sh 的預設值或登入後自動推算。
# 登入後可在選單項目 19 查看每個值實際用了什麼、來源是 conf、derived(推算)或 default(預設)。
OPMENU_ENV_LABEL=PROD

# 連線:只要填 bootstrap(broker 的 LDAP listener,人員用 AD 帳密)。以下由它推算(可用同名設定覆蓋):
#   OPMENU_MDS_URL              = bootstrap 每台主機 + https + OPMENU_MDS_PORT(預設 8090)
#   OPMENU_BREAKGLASS_BOOTSTRAP = bootstrap 每台主機 + OPMENU_TOKEN_PORT(預設 9094;91 緊急模式用憑證換 token 走這個 listener)
#   OPMENU_KAFKA_CLUSTER_ID     = 向 MDS 查 /v1/metadata/id
#   OPMENU_HOSTS                = BROKER_SERVICES、AUX_SERVICES 的主機 + CONTROLLER_HOSTS(它是 ssh 的允許清單,不從 cluster 推算)
OPMENU_BOOTSTRAP='kb01.poc.lab:9096,kb02.poc.lab:9096,kb03.poc.lab:9096,kb04.poc.lab:9096'

# certificate 目錄:truststore(truststore.p12,只放銀行根憑證)、truststore 密碼檔(truststore.pass)、CA(ca.pem)預設都在這裡
OPMENU_CERT_DIR='/etc/opmenu/ssl'

# 必須填:可重啟的服務與 controller。這些是重啟與 ssh 的允許清單,要經變更管理審過,不從 cluster 推算(broker 掛掉後就不在 cluster 的清單裡,正是需要重啟的那台)
OPMENU_BROKER_SERVICES='kb01.poc.lab:confluent-server kb02.poc.lab:confluent-server kb03.poc.lab:confluent-server kb04.poc.lab:confluent-server'   # 主機:systemd 服務名
OPMENU_AUX_SERVICES='rest01.poc.lab:confluent-kafka-rest rest02.poc.lab:confluent-kafka-rest c3-01.poc.lab:confluent-control-center'
OPMENU_CONTROLLER_HOSTS='kc01.poc.lab kc02.poc.lab kc03.poc.lab'

# 主機登入:操作機(人員經 PSMP 登入就是 root)以 cpuser ssh 到各主機(和安裝同一個帳號),私鑰是操作機獨立 file system 上的檔案(root 0400,和安裝同一把)
OPMENU_SSH_USER=cpuser
OPMENU_SSH_KEY_FILE='/secure/ssh/cpuser_ed25519'
# 主機上 cpuser 的 sudo 永久只開(安裝、升級時才由 OS 團隊依變更單開全權),逐一列出服務與指令寫法,不用 confluent-* 萬用字元
# (sudoers 比對完整參數;選單只用這三種寫法,journalctl 的行數固定 200,見 lib/hosts.sh):
#   cpuser ALL=(root) NOPASSWD: /usr/bin/systemctl restart confluent-server, \
#       /usr/bin/systemctl status confluent-server, \
#       /usr/bin/journalctl -u confluent-server -n 200 --no-pager
#   (REST Proxy 主機把服務名換成 confluent-kafka-rest,C3 主機換成 confluent-control-center;每台只列自己的服務)

# 操作者身分:操作機上人員是 root(經 CyberArk PSMP 登入),所以操作者自己輸入 AD 帳號與密碼(Kafka 身分);作業系統帳號只在紀錄裡附註
OPMENU_USER_FROM_OS=0

# 機敏資料:91 緊急模式的憑證由維運人員從 CyberArk PVWA 取出後貼上(lib/secrets/manual.sh,唯一的來源);下面是提示用的 object 名稱
OPMENU_BREAKGLASS_SECRET='kafka/breakglass/pem'         # 91 緊急模式憑證(私鑰 + 憑證鏈 PEM),身分 User:opmenu-breakglass 在 MDS 綁 SystemAdmin

# 規範(依客戶規定)
OPMENU_TOPIC_PATTERN='^[a-z][a-z0-9]+\.[a-z0-9.-]+$'
OPMENU_SVC_PATTERN='^[a-z][a-z0-9-]+$'
# OPMENU_REPLICATION=3             # 建 topic 的 replication factor;預設 3,broker 少於 3 台時自動降到 broker 數
OPMENU_IDLE_TIMEOUT=900
OPMENU_AUDIT_GROUP_PREFIX='audit-' # 43 讀 audit 用的 consumer group prefix(audit 群組要有它的 DeveloperRead)
# OPMENU_CHANGE_WINDOW='Mon-Fri 22:00-06:00;Sat,Sun 00:00-23:59'   # 變更類項目的時窗;空 = 不限制
OPMENU_LOG=/var/log/opmenu/opmenu.log   # 程式目錄唯讀,紀錄與匯出檔放這裡(目錄要讓 opmenu 群組可寫);OPMENU_SYSLOG=1 另送 syslog
