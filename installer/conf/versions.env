# Single source of truth for every version. Read by windows/download-packages.sh and by cpctl.
# Bash-sourceable KEY=VALUE only.

CP_VERSION=8.3.2
CP_RELEASE=8.3                 # repo path segment and metadata release version for finalize
CP_UPGRADE_FROM=8.2.4          # older version kept in the internal repo for the minor-upgrade drill
CP_UPGRADE_FROM_RELEASE=8.2
C3_VERSION=2.6.1
JDK_PACKAGE=temurin-21-jdk
JDK_VERSION=21.0.12.1.0.1      # RPM version (without -release); see dnf repoquery

# Upstream sources (used only by the Internet-side download host)
CONFLUENT_RPM_BASE=https://packages.confluent.io/rpm
CONFLUENT_GPG_KEY=https://packages.confluent.io/rpm/8.3/archive.key
C3_RPM_BASE=https://packages.confluent.io/confluent-control-center-next-gen/rpm/
C3_GPG_KEY=https://packages.confluent.io/confluent-control-center-next-gen/rpm/archive.key
ADOPTIUM_RPM_BASE=https://packages.adoptium.net/artifactory/rpm/rhel/9/x86_64
ADOPTIUM_GPG_KEY=https://packages.adoptium.net/artifactory/api/gpg/key/public
CONFLUENT_TAR_BASE=https://packages.confluent.io/archive

# Packages per role (names verified with dnf repoquery against the 8.3 repo)
PKGS_CONTROLLER="confluent-server confluent-security"
PKGS_BROKER="confluent-server confluent-security"
PKGS_REST="confluent-kafka-rest confluent-security"
PKGS_OPS="confluent-server confluent-security confluent-cli"
PKGS_JUMP="confluent-server confluent-security"   # Kafka CLI tools for the OP menu (no service runs there)
PKGS_C3="confluent-control-center-next-gen"
PKGS_C3_OS="cyrus-sasl openssl-devel"   # documented C3 prerequisites (from the OS repo)

# tar.gz strategy (INSTALL_METHOD=tar)
JDK_TAR_MAJOR=21

# Monitoring agent for external monitoring systems (Prometheus JMX exporter, javaagent)
JMX_EXPORTER_VERSION=1.0.1
JMX_EXPORTER_URL=https://repo1.maven.org/maven2/io/prometheus/jmx/jmx_prometheus_javaagent/1.0.1/jmx_prometheus_javaagent-1.0.1.jar
# OS packages normally present on a bank RHEL baseline; mirrored so the OS layer can be tested
PKGS_OS_BASELINE="chrony firewalld"
# Internal repo served over HTTPS by the ops host (REPO_YUM_BASEURL=https://...): TLS module for httpd
PKGS_OPS_OS="mod_ssl"

# OP menu for the bastion (internal software, packaged by windows/package-opmenu.sh)
OPMENU_VERSION=20261016.f03b18c0
