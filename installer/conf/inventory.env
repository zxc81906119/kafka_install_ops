# Inventory: data only, no logic. Query it through lib/inventory.sh (inv::*).
PROFILE=poc                    # poc | prod  (heap sizes, AD bootstrap mode, container-only shortcuts)
INSTALL_METHOD=rpm             # rpm | tar   (lib/install/<method>.sh)
REPO_PROVIDER=local            # local       (lib/repo/<provider>.sh)

DOMAIN=poc.lab
SSH_USER=cpadmin
# sudo of the installer account on every host:
#   full        cpadmin may run anything as root (PoC images; bootstrap)
#   restricted  only the cpnode agent (cpctl agent install --restrict); writes limited to conf/cpnode.paths
# A NEW environment starts with full (PoC images / bootstrap), then: cpctl agent install --restrict -> restricted.
# cp-poc runs restricted since 2026-10-18.
SUDO_MODE=restricted
# on = deny writes outside conf/cpnode.paths; warn = only log them (learning mode, /var/log/cpnode.log)
SUDO_AGENT_ENFORCE=on
OPS_HOST=ops01

# Internal repo. The ops host always BUILDS it (verify, createrepo_c) under /srv/repo. Who SERVES it:
#   REPO_WEB_HOST empty  the ops host itself (httpd configured by cpctl; https:// = cp-server certificate, port 8443)
#   REPO_WEB_HOST set    a separate web server the bank runs: cpctl only pushes files to REPO_WEB_ROOT over SSH
#                        as REPO_WEB_USER (needs sshd + tar there - no root, no createrepo_c); the bank owns its
#                        httpd and certificate. REPO_WEB_CA = the CA chain of that certificate (nodes pin it).
# Replace with Satellite/Artifactory/Nexus URLs when the bank has one.
REPO_WEB_HOST=repo01.poc.lab
REPO_WEB_USER=repodeploy
REPO_WEB_ROOT=/var/www/repo
REPO_WEB_CA=/var/lib/cp-installer/pki/trust/bank-root-g2.pem
REPO_YUM_BASEURL=https://repo01.poc.lab/rpm
REPO_RAW_BASEURL=https://repo01.poc.lab/raw

# Roles -> hosts (short names; FQDN = <host>.<DOMAIN>)
HOSTS_controller="kc01 kc02 kc04"   # kc03 replaced by kc04 in the dynamic-quorum drill
HOSTS_controller_spare="kc03"
HOSTS_broker="kb01 kb02 kb03 kb04"
HOSTS_rest="rest01 rest02"
HOSTS_c3="c3-01"
HOSTS_lb="lb01"
HOSTS_ad="ad01"
HOSTS_ops="ops01"
HOSTS_jump="jump01"   # bastion running the OP menu (not part of inv::all_hosts: no server cert SAN needed)

# Per-host attributes: HOST_<host with - replaced by _>_<KEY>
HOST_kc01_NODE_ID=1
HOST_kc02_NODE_ID=2
HOST_kc03_NODE_ID=3
HOST_kc04_NODE_ID=4
HOST_kb01_NODE_ID=101
HOST_kb02_NODE_ID=102
HOST_kb03_NODE_ID=103
HOST_kb04_NODE_ID=104
HOST_kb01_RACK=rack-a
HOST_kb02_RACK=rack-a
HOST_kb03_RACK=rack-b
HOST_kb04_RACK=rack-b
HOST_rest01_REST_ID=rest-01
HOST_rest02_REST_ID=rest-02

# Virtual names behind the load balancer
LB_REST_NAME=rest.poc.lab
LB_C3_NAME=c3.poc.lab
# Control Center access. C3 is a single host used by operators only (via the bastion / VDI): a load balancer in
# front of one host adds nothing, so C3 is reached directly by default.
#   no   operators open https://<C3 host>:9021 directly; the LB carries REST Proxy only   (default)
#   yes  the LB also forwards 9021 to C3 under LB_C3_NAME (only when the bank requires every UI behind a proxy)
# Production: give C3 a stable DNS alias (e.g. c3.bank.local -> the C3 host) and keep it in the server SAN.
C3_VIA_LB=no

# Ports
PORT_CONTROLLER=9093
PORT_INTERNAL=9092
PORT_TOKEN=9094
PORT_CLIENT=9095
PORT_LDAP=9096
PORT_MDS=8090
PORT_REST=8082
PORT_C3=9021
PORT_PROMETHEUS=9090
PORT_ALERTMANAGER=9093
# Prometheus JMX exporter (javaagent) on every controller / broker / REST host, scraped by the bank's Prometheus
PORT_JMX_EXPORTER=7071

# Active Directory
AD_HOST=ad01
AD_LDAP_HOSTS="ad01"         # all DCs for LDAPS failover, e.g. "ad01 ad02"
AD_REALM=CORP.POC.LAB
AD_BASE_DN=DC=corp,DC=poc,DC=lab
AD_OU=OU=Confluent,DC=corp,DC=poc,DC=lab

# Heap per profile
HEAP_poc_controller=384m
HEAP_poc_broker=512m
HEAP_poc_rest=512m
HEAP_poc_c3=1536m
HEAP_prod_controller=4g
HEAP_prod_broker=6g
HEAP_prod_rest=1g
HEAP_prod_c3=6g

# Prometheus retention per profile
PROM_RETENTION_poc=2d
PROM_RETENTION_prod=15d

# Certificates
#   PKI_MODE=internal  cpctl's own CA on the ops host signs every certificate
#   PKI_MODE=external  the bank's PKI signs: cpctl creates key + CSR + request sheet (pki/requests/), the bank's
#                      answer goes to pki/incoming/<name>.crt and is checked before use; truststores hold only
#                      the bank roots (cpctl certs trust add). Migration internal -> external: manual chapter 9.4
PKI_MODE=external
PKI_SUBJECT_SUFFIX="/OU=Confluent/O=PoC Bank/C=TW"
PKI_KEY_BITS=3072
PKI_CA_DAYS=3650
PKI_CERT_DAYS=365
PKI_RENEW_BEFORE_DAYS=30

# Secret Protection (confluent secret): on = no plaintext passwords in component .properties files
SECRET_PROTECTION=on

# External monitoring: JMX exporter javaagent (HTTPS with the node's certificate + basic auth, hashed password)
# cpctl monitoring export -> scrape config + alert rules for the bank's Prometheus / Alertmanager
JMX_EXPORTER=on
JMX_EXPORTER_USER=prometheus
JMX_EXPORTER_DIR=/opt/jmx-exporter

# OP menu on the bastion (opmenu, packaged by windows/package-opmenu.sh, version in versions.env).
# Scenario: bastion and nodes are NOT joined to AD and only have fixed accounts. Operators log in to the menu with
# their OWN AD credentials (verified by MDS); Kafka RBAC decides Kafka actions, MDS authorize gates host actions.
OPMENU=on
OPMENU_OS_USER=opuser            # fixed bastion account; its login shell is the menu (ForceCommand for ssh)
OPMENU_NODE_USER=kafkaops        # fixed node account used by the menu over ssh; sudo: restart/journalctl/clean logs only
OPMENU_BREAKGLASS=opmenu-breakglass   # certificate identity for menu item 91 (SystemAdmin binding, held by opbootstrap)
OPMENU_ENV_LABEL=POC
OPMENU_TICKET_MODE=required
OPMENU_CHANGE_WINDOW=""          # e.g. "Mon-Fri 22:00-06:00;Sat,Sun 00:00-23:59"; empty = no restriction
