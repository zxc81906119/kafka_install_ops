# Audit logs (Confluent Server "security event logger"), rendered into every controller / broker.
# Writer principal: a local SCRAM user with only DeveloperWrite + DeveloperManage on the audit topics.
AUDIT_PRINCIPAL=confluent-audit
AUDIT_BINDINGS="DeveloperWrite:Topic:confluent-audit-log-events:PREFIXED DeveloperManage:Topic:confluent-audit-log-events:PREFIXED"

# Default destination (everything not routed below): allowed + denied events
AUDIT_TOPIC=confluent-audit-log-events
AUDIT_RETENTION_DAYS=90

# Sensitive data: produce / consume on these topic prefixes (allowed AND denied) go to their own topic
AUDIT_SENSITIVE_TOPIC=confluent-audit-log-events_sensitive
AUDIT_SENSITIVE_PREFIXES="payments."
AUDIT_SENSITIVE_RETENTION_DAYS=365

# Not logged (volume): the shared broker/controller identity; Control Center's polling service account
AUDIT_EXCLUDED_PRINCIPALS="User:kafka-internal User:svc-c3"
