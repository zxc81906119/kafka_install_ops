# OS baseline applied by step 01_os_baseline (check-then-act; container-only limits are reported, not forced).
# sysctl lists: space separated key=value; commas inside a value stand for spaces (e.g. tcp_rmem).
SYSCTL_ALL="net.core.somaxconn=4096 net.ipv4.tcp_max_syn_backlog=4096"
SYSCTL_KAFKA="vm.max_map_count=262144"
SYSCTL_BROKER="vm.swappiness=1 vm.dirty_background_ratio=5 vm.dirty_ratio=60 net.core.rmem_max=2097152 net.core.wmem_max=2097152 net.ipv4.tcp_rmem=4096,65536,2097152 net.ipv4.tcp_wmem=4096,65536,2097152"

LIMIT_NOFILE=128000
LIMIT_NPROC=65536
JOURNAL_MAX_USE=1G
TIMEZONE=Asia/Taipei

# Rolled application logs (log4j2 rolls but never deletes) are removed after N days by systemd-tmpfiles
LOG_RETENTION_DAYS=14
LOG_DIRS="/var/log/kafka /var/log/confluent"

# ---- OS services (packages come from the internal os-deps mirror: PKGS_OS_BASELINE in versions.env)
# Transparent hugepages off on every Kafka host (disable-thp.service; systemd skips it inside containers)
THP_MODE=never
# Time sync: every host follows NTP_SERVERS. PoC: ops01 serves time to the lab subnet (prod: the bank NTP servers).
NTP_SERVERS="ops01.poc.lab"
NTP_SERVER_ALLOW="172.30.0.0/24"
# Firewall: firewalld default zone = ssh + the ports of the host's roles (set FIREWALLD=off if the bank uses
# network firewalls only). Ports are derived from inventory.env; extras below are added per role.
FIREWALLD=on
FIREWALL_EXTRA_ops="8443"   # internal repo (HTTPS); 8080 (plain HTTP) is no longer opened
# opened by the Rocky/RHEL default zone, not needed on these servers
FIREWALL_REMOVE_SERVICES="cockpit dhcpv6-client"
# SELinux: expected mode; restorecon runs on the Confluent paths after every change
SELINUX_MODE=enforcing
SELINUX_PATHS="/etc/confluent /var/lib/kafka /var/log/kafka /var/log/confluent /opt/confluent /opt/jmx-exporter"
