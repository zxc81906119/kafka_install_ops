# Version compatibility used by `cpctl upgrade plan`. Space separated lists.
# Source: Confluent release notes / C3 system requirements (C3 2.6.x supports CP 7.5.15 - 8.3.x).

# Allowed upgrade paths: "<from major.minor>><to major.minor>"
UPGRADE_PATHS="8.2>8.3 8.3>8.3"

# Control Center releases and the CP minor versions they support
C3_SUPPORTS_2_6="7.5 7.6 7.7 7.8 7.9 8.0 8.1 8.2 8.3"

# JDK majors supported per CP minor
JDK_SUPPORTS_8_2="17 21"
JDK_SUPPORTS_8_3="17 21 25"

# Static configs that must not be present before upgrading to 8.3 (removed in Kafka 4.x)
FORBIDDEN_CONFIGS_8_3="message.format.version message.downconversion.enable message.timestamp.difference.max.ms"

# Kafka release version per CP minor (kafka-features --release-version)
KAFKA_RELEASE_8_2=4.2
KAFKA_RELEASE_8_3=4.3
