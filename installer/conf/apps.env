# Machine identities (applications).
# Access policy:
#   scram : the normal path - Kafka client straight to the brokers (CLIENT listener, SASL_SSL SCRAM-SHA-512)
#   rest  : legacy apps only - mTLS to REST Proxy (behind the LB); a client certificate CN=<app> is issued
#           and REST Proxy accepts ONLY these CNs (principal mapping is generated from this list, no DEFAULT)
# RBAC bindings are always on User:<app> (mTLS principals cannot use group bindings - official limitation).
APPS="app-orders app-payments app-legacy-billing"
APP_CHANNEL_app_orders=scram
APP_CHANNEL_app_payments=scram
APP_CHANNEL_app_legacy_billing=rest

# Binding syntax (space separated):
#   <Role>                                  cluster-scoped role (e.g. SystemAdmin, Operator)
#   <Role>:<ResourceType>:<Name>:<Pattern>  resource-scoped; Pattern = LITERAL | PREFIXED
APP_BINDINGS_app_orders="DeveloperWrite:Topic:orders.:PREFIXED DeveloperRead:Topic:orders.:PREFIXED DeveloperRead:Group:orders-:PREFIXED DeveloperManage:Topic:orders.:PREFIXED"
APP_BINDINGS_app_payments="DeveloperWrite:Topic:payments.:PREFIXED DeveloperRead:Topic:payments.:PREFIXED"
APP_BINDINGS_app_legacy_billing="DeveloperWrite:Topic:billing.:PREFIXED DeveloperRead:Topic:billing.:PREFIXED DeveloperRead:Group:billing-:PREFIXED"

# Topics created by step 08 (name:partitions)
TOPICS="orders.events:6 payments.events:6 billing.events:3"

# Human AD groups (created in AD by 04_ad_bootstrap in PoC mode) and their bindings
AD_GROUPS="kafka-admins kafka-operators kafka-devs"
GROUP_BINDINGS_kafka_admins="SystemAdmin"
GROUP_BINDINGS_kafka_operators="Operator"
GROUP_BINDINGS_kafka_devs="DeveloperRead:Topic:orders.:PREFIXED DeveloperRead:Group:dev-:PREFIXED"

# Human test users: <user>:<group>
AD_USERS="alice:kafka-admins bob:kafka-operators carol:kafka-devs"

# AD service accounts. All of them are added to impersonation.protected.users automatically,
# together with every entry of super.users, so REST Proxy can never act as one of them.
AD_SERVICE_ACCOUNTS="svc-mds-bind svc-rest svc-c3 svc-cpctl"
# Extra bindings per service account.
# REST Proxy's security plugin validates the license itself: it must be able to read the license topics.
SERVICE_ACCOUNTS="svc-rest"
SERVICE_BINDINGS_svc_rest="DeveloperRead:Topic:_confluent-license:LITERAL DeveloperRead:Topic:_confluent-command:LITERAL DeveloperRead:Topic:__internal_confluent_only_broker_info:LITERAL"
