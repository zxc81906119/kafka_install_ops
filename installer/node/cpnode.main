# ---- cpnode main (appended after the node function bundle by "cpctl agent build") -------------------------------
# Installed root:root 0755 as /usr/local/libexec/cpctl/cpnode. With SUDO_MODE=restricted it is the ONLY program the
# installer account may run through sudo, and only WITHOUT arguments (sudoers: cpnode ""):
#   ssh <host> sudo -n /usr/local/libexec/cpctl/cpnode   < NUL-separated: CPCTL_CHECK, CPCTL_DIFF, <function>, <args...>
# - no eval, no shell snippets: the function must be one of the bundle's own functions (namespace::name)
# - every path a function writes or removes is checked against /etc/cpctl/cpnode.conf (CPNODE_WRITE_PATHS);
#   sudoers drop-ins only for CPNODE_SUDOERS_USERS; never setuid/setgid; staged files only from the caller's /tmp/cpctl.*
# - arguments travel on stdin, so sudo's log shows no secrets; cpnode logs every call itself (secrets masked)
readonly CPNODE_CONF=/etc/cpctl/cpnode.conf CPNODE_LOG=/var/log/cpnode.log
CPNODE_ENFORCE=on
CPNODE_WRITE_PATHS=""
CPNODE_SUDOERS_USERS=""
CPNODE_TEST_FUNCTIONS=0
# the configuration must be root's and not writable by anyone else, otherwise it is ignored (defaults = deny)
if [[ -f $CPNODE_CONF && $(stat -c '%u %a' "$CPNODE_CONF") =~ ^0\ [0-7][0-5][0-5]$ ]]; then
  # shellcheck source=/dev/null
  . "$CPNODE_CONF"
fi

cpnode::log() { printf '%s %s %s\n' "$(date '+%F %T')" "${SUDO_USER:-?}" "$*" >>"$CPNODE_LOG" 2>/dev/null || true; }
cpnode::die() { cpnode::log "DENIED $*"; printf '::warn:: cpnode: %s\n' "$*" >&2; exit 126; }

# cpnode::_allowed <path> -> matches one of the CPNODE_WRITE_PATHS globs
cpnode::_allowed() {
  local g globs=()
  read -ra globs <<<"$CPNODE_WRITE_PATHS"   # read -a: the patterns are NOT expanded against the file system
  for g in "${globs[@]}"; do
    # shellcheck disable=SC2053
    [[ $1 == $g ]] && return 0
  done
  return 1
}

cpnode::_staged_ok() { # <src>
  [[ -f $1 && ! -L $1 ]] || return 1
  case $1 in
    /tmp/cpctl.*) [[ $(stat -c %u "$1") == "${SUDO_UID:-x}" ]] ;;
    /tmp/cpnode.*) [[ $(stat -c %u "$1") == 0 ]] ;;
    *) return 1 ;;
  esac
}

# cpnode::check_path <dest> [staged src] [mode] -> called by the write primitives (ensure::*, tar_node::*)
cpnode::check_path() {
  local dst=$1 src=${2:-} mode=${3:-} why=""
  if [[ $dst != /* || $dst == *..* ]]; then why="not a clean absolute path: $dst"
  elif ! cpnode::_allowed "$dst"; then why="path not allowed: $dst"
  elif [[ -n $mode ]] && (((8#${mode#0} & 04000) != 0)); then why="setuid mode $mode for $dst"
  # setgid only on directories (group inheritance, e.g. a shared log dir); a setgid FILE is an escalation path
  elif [[ -n $mode && -n $src ]] && (((8#${mode#0} & 02000) != 0)); then why="setgid file mode $mode for $dst"
  # staged files: the caller's own /tmp/cpctl.* (scp'd by cpctl) or a root-owned /tmp/cpnode.* the agent's own node
  # functions created (the caller cannot create root-owned files)
  elif [[ -n $src ]] && ! cpnode::_staged_ok "$src"; then
    why="staged file $src is neither the caller's own /tmp/cpctl.* file nor an agent /tmp/cpnode.* file"
  elif [[ $dst == /etc/sudoers.d/* && -n $src ]]; then
    local line who
    while IFS= read -r line; do
      [[ -z ${line// /} || $line == \#* ]] && continue
      who=${line%%[[:space:]]*}
      who=${who#Defaults:}
      [[ " $CPNODE_SUDOERS_USERS " == *" $who "* ]] || { why="sudoers line for '$who' in $dst (allowed: $CPNODE_SUDOERS_USERS)"; break; }
    done <"$src"
    [[ -z $why ]] && ! visudo -cqf "$src" >/dev/null 2>&1 && why="sudoers $dst does not validate"
  fi
  [[ -z $why ]] && return 0
  if [[ $CPNODE_ENFORCE == warn ]]; then
    cpnode::log "WOULD-DENY $why"
    printf '::warn:: cpnode (learning mode) would deny: %s\n' "$why"
    return 0
  fi
  cpnode::die "$why"
}

cpnode::main() {
  local argv=() fn i masked=()
  mapfile -d '' -t argv
  ((${#argv[@]} >= 3)) || cpnode::die "usage: NUL-separated CPCTL_CHECK CPCTL_DIFF function [args...] on stdin"
  export CPCTL_CHECK=${argv[0]} CPCTL_DIFF=${argv[1]} CPNODE_RESTRICTED=1
  [[ $CPCTL_CHECK =~ ^[01]$ && $CPCTL_DIFF =~ ^[01]$ ]] || cpnode::die "bad mode flags"
  fn=${argv[2]}
  if [[ $fn == --version ]]; then printf '%s\n' "$CPNODE_VERSION"; return 0; fi
  [[ $fn =~ ^[a-z][a-z0-9_]*::[a-z][a-z0-9_]*$ ]] && declare -F "$fn" >/dev/null || cpnode::die "unknown function: $fn"
  [[ $fn == opmenu_test::* && $CPNODE_TEST_FUNCTIONS != 1 ]] && cpnode::die "test functions are disabled: $fn"
  [[ $fn == cpnode::* ]] && cpnode::die "not callable: $fn"
  for ((i = 3; i < ${#argv[@]}; i++)); do
    case "$fn:$((i - 2))" in
      ad::ensure_user:2 | opmenu_test::run:4) masked+=("<hidden>") ;;
      *) masked+=("$(sed -E 's/password=[^],]*/password=<hidden>/g' <<<"${argv[i]}")") ;;
    esac
  done
  cpnode::log "as=$(id -un) check=$CPCTL_CHECK $fn ${masked[*]}"
  "$fn" "${argv[@]:3}"
}

cpnode::main
