# install/conf/site.env — 每個環境只改這一個檔（主機名稱、版本、AD、堆積大小）
# 所有腳本都 source 這個檔；值裡不放任何密碼（密碼一律在 ~/secrets/*.pass、~/pki/store.pass，0600）。

DOMAIN=poc.lab                       # 所有主機的 FQDN = <主機>.$DOMAIN

OPS_HOST=ops02                       # 操作機（腳本 02–14 在這裡跑，帳號 cpadmin）
CONTROLLERS="kc01 kc02 kc03"
BROKERS="kb01 kb02 kb03 kb04"
RESTS="rest01 rest02"
C3_HOST=c3-01

# 銀行提供的周邊
REPO_HOST=repo01                     # 套件庫 web server（只有 httpd，HTTPS）
REPO_DEPLOY_USER=repodeploy          # 可寫 /var/www/repo 的部署帳號（ssh 金鑰同 cpadmin）
REPO_URL=https://repo01.poc.lab      # 主機看到的套件庫 base URL（/os/ 是銀行的 OS 套件、/confluent/ 是我們上架的）
AD_HOST=ad01
AD_LDAPS_PORT=636
AD_SEARCH_BASE="OU=Confluent,DC=corp,DC=poc,DC=lab"
AD_GROUP_SEARCH_BASE="OU=Groups,OU=Confluent,DC=corp,DC=poc,DC=lab"
AD_BIND_DN="CN=svc-mds-bind,OU=Service,OU=Confluent,DC=corp,DC=poc,DC=lab"
LB_HOST=lb01
REST_VIP=rest.poc.lab                # 負載平衡上 REST Proxy 的名稱（指到 lb01）
C3_VIP=c3.poc.lab
NTP_SERVER=repo01.poc.lab            # 行內 NTP（lab 由 repo01 兼任）

# 版本（下載、安裝、鎖版本都用這兩個）
CP_VERSION=8.3.2
C3_VERSION=2.6.1
JMX_EXPORTER_VERSION=1.0.1
FETCH_JDK=1                          # 1：下載機順便抓 Temurin 21 當「銀行交付的 JDK」（lab）；正式環境設 0，JDK 由銀行交付到 landing/bank/

# node.id 與機櫃（controller 1–3、broker 101–104）
NODE_ID_kc01=1;   RACK_kc01=-
NODE_ID_kc02=2;   RACK_kc02=-
NODE_ID_kc03=3;   RACK_kc03=-
NODE_ID_kb01=101; RACK_kb01=rack-a
NODE_ID_kb02=102; RACK_kb02=rack-a
NODE_ID_kb03=103; RACK_kb03=rack-b
NODE_ID_kb04=104; RACK_kb04=rack-b

# JVM heap（lab 規格；正式環境依主機記憶體調整）
HEAP_CONTROLLER=384m
HEAP_BROKER=512m
HEAP_REST=512m
HEAP_C3=1536m

# 操作機上的目錄（和手把手文件 0.4 一致）
LANDING=$HOME/landing                # 銀行送進來的檔案（唯讀）
REPO_DIR=$HOME/repo
PKI_DIR=$HOME/pki
CONF_DIR=$HOME/conf
SECRETS_DIR=$HOME/secrets

# 衍生清單（不用改）
KAFKA_HOSTS="$CONTROLLERS $BROKERS"
CLUSTER_HOSTS="$CONTROLLERS $BROKERS $RESTS $C3_HOST"
ALL_HOSTS="$OPS_HOST $CLUSTER_HOSTS"
fqdn() { echo "$1.$DOMAIN"; }
join_fqdn() { local port=$1; shift; local out=""; for h in "$@"; do out+="${out:+,}$(fqdn "$h"):$port"; done; echo "$out"; }
CONTROLLER_QUORUM=$(join_fqdn 9093 $CONTROLLERS)                  # kc01.poc.lab:9093,…
BROKER_INTERNAL=$(join_fqdn 9092 $BROKERS)
BROKER_TOKEN=$(join_fqdn 9094 $BROKERS)
MDS_URLS=$(for h in $BROKERS; do printf "https://%s:8090," "$(fqdn "$h")"; done | sed "s/,$//")
AD_FQDN=$(fqdn "$AD_HOST")
C3_FQDN=$(fqdn "$C3_HOST")
OPS_FQDN=$(fqdn "$OPS_HOST")
