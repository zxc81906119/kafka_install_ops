# install/conf/site.env —— 站點設定。每個環境只改這一個檔（主機名稱、版本、AD、heap、延伸站開關）
#
# 所有步驟都 source 這個檔。這裡不放任何密碼：密碼一律在 ~/secrets/*.pass、~/pki/store.pass（0600），
# 或銀行的保管庫。檔案分兩半：上半是「要改的值」，下半「衍生值」由上半算出來，不用改。

# ======================================================================
# 要改的值
# ======================================================================

DOMAIN=poc.lab                       # 所有主機的 FQDN = <主機>.$DOMAIN

# 主機（短名）
OPS_HOST=ops02                       # 操作機：步驟 02 以後都在這裡以 cpadmin 執行
CONTROLLERS="kc01 kc02 kc03"         # KRaft controller
BROKERS="kb01 kb02 kb03 kb04"        # broker（MDS 也在上面）
RESTS="rest01 rest02"                # REST Proxy
C3_HOST=c3-01                        # Control Center（含內建 Prometheus、Alertmanager）

# 銀行提供的周邊
REPO_HOST=repo01                     # 套件庫 web server（只有 httpd，HTTPS）
REPO_DEPLOY_USER=repodeploy          # 可寫 /var/www/repo 的部署帳號（ssh 金鑰同 cpadmin）
REPO_URL=https://repo01.poc.lab      # 主機看到的套件庫網址：/os/ 是銀行的 OS 套件、/confluent/ 是我們上架的
AD_HOST=ad01                         # 行內 AD（LDAPS）
AD_LDAPS_PORT=636
AD_SEARCH_BASE="OU=Confluent,DC=corp,DC=poc,DC=lab"                  # 找人員的起點
AD_GROUP_SEARCH_BASE="OU=Groups,OU=Confluent,DC=corp,DC=poc,DC=lab"  # 找群組的起點
AD_BIND_DN="CN=svc-mds-bind,OU=Service,OU=Confluent,DC=corp,DC=poc,DC=lab"  # MDS 查 AD 用的唯讀帳號
LB_HOST=lb01                         # 負載平衡
REST_VIP=rest.poc.lab                # 負載平衡上 REST Proxy 的名稱（應用程式連這個）
LB_CONTROL=handshake                 # 重啟 REST 前請 LB 團隊停用那一台（手把手 12.1）。handshake：寫 $LB_REQUEST_DIR/<主機>.down、等回覆；none：沒有 LB，只警告
LB_REQUEST_DIR=$HOME/lb-requests     # 請求檔：<主機>.down|up；LB 團隊做完後 touch <請求>.done（有終端機時直接按 Enter）
LB_WAIT_SECONDS=1800                 # 等 LB 團隊回覆最多幾秒
C3_VIP=c3.poc.lab                    # C3 的別名（寫進 cp-server 憑證的 SAN）
NTP_SERVER=repo01.poc.lab            # 行內 NTP（lab 由 repo01 兼任）

# 版本（下載、安裝、鎖版本都用這裡的值）
CP_VERSION=8.3.2                     # Confluent Platform
C3_VERSION=2.6.1                     # Control Center next-gen
JMX_EXPORTER_VERSION=1.0.1
FETCH_JDK=1                          # 1：下載機順便抓 Temurin 21 當「銀行交付的 JDK」（lab 用）；正式環境設 0，JDK 由銀行交付到 landing/bank/

# 每台 controller／broker 的 node.id 與機櫃（變數名 = NODE_ID_<主機>、RACK_<主機>）
NODE_ID_kc01=1;   RACK_kc01=-
NODE_ID_kc02=2;   RACK_kc02=-
NODE_ID_kc03=3;   RACK_kc03=-
NODE_ID_kb01=101; RACK_kb01=rack-a
NODE_ID_kb02=102; RACK_kb02=rack-a
NODE_ID_kb03=103; RACK_kb03=rack-b
NODE_ID_kb04=104; RACK_kb04=rack-b

# JVM heap（lab 規格；正式環境依主機記憶體調整）
HEAP_CONTROLLER=384m
HEAP_BROKER=512m
HEAP_REST=512m
HEAP_C3=1536m

# 操作機上的目錄（和手把手文件 0.4「操作機上的檔案放哪」一致）
LANDING=$HOME/landing                # 銀行送進來的檔案（唯讀）
REPO_DIR=$HOME/repo                  # 要上架到套件庫的目錄
PKI_DIR=$HOME/pki                    # 私鑰 keys/、申請單 requests/、銀行回覆 incoming/、成品 certs/、keystore 密碼 store.pass
CONF_DIR=$HOME/conf                  # 產生出來的設定、client 連線設定、kraft.env
SECRETS_DIR=$HOME/secrets            # 各種密碼檔（0600）
MONITORING_DIR=$HOME/monitoring      # 第 17 站產生的 exporter 設定與給銀行監控團隊的檔

# 操作機 ssh 到各主機 cpadmin 用的私鑰從哪來
#   file  ：~/.ssh/id_ed25519（lab；第 3 站沒有就產生一把）
#   agent ：變更窗口內工程師從 CyberArk PVWA 取出，貼進 ssh-agent（eval $(ssh-agent -s); ssh-add -t 4h -），不落地；客戶正式環境用這個
SSH_KEY_SOURCE=file

# ---- 延伸站（第 15–18 章）的開關。不要的設成 0 ----
SECRETS_MODE=sp                      # 密碼放法：sp（第 15 站 Secret Protection，master key 在 PVWA 保管）| plain（不處理，不建議）
PVWA_SAFE=kafka                      # PVWA 裡放本平台機敏資料的 safe 名稱（第 15、16 站的 object 名稱用）
OPMENU=1                             # 第 16 站：維運選單（裝在操作機）
OPMENU_OS_USER=op01                  # 維運人員的本機帳號（lab：op01；客戶：opxx）
OPMENU_ENV_LABEL=LAB                 # 選單畫面上的環境標籤（客戶：PROD／UAT）
JMX_EXPORTER=1                       # 第 17 站：給行內 Prometheus 的 JMX exporter（7071）
AUDIT_LOG=1                          # 第 18 站：稽核日誌路由
AUDIT_SENSITIVE_PREFIX=payments.     # 這個 prefix 的 topic 的事件進 _sensitive（留 365 天），其他留 90 天

# ======================================================================
# 衍生值（由上面算出來，不用改）
# ======================================================================

INSTALL_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)   # install/ 的位置
TEMPLATE_DIR=$INSTALL_DIR/templates
CERTS_DIR=$PKI_DIR/certs             # 憑證成品：*.crt（PEM）、*.p12（keystore）、truststore.p12、bank-root.pem
KEYS_DIR=$PKI_DIR/keys               # 私鑰
BANK_ROOT_CA=/etc/pki/ca-trust/source/anchors/bank-root.pem   # 銀行根憑證（第 3 站由 OS 團隊放進每台主機的信任清單）

# 主機清單
KAFKA_HOSTS="$CONTROLLERS $BROKERS"                  # 跑 confluent-server 的主機
CLUSTER_HOSTS="$CONTROLLERS $BROKERS $RESTS $C3_HOST" # 平台的所有主機（不含操作機）
ALL_HOSTS="$OPS_HOST $CLUSTER_HOSTS"                 # 含操作機

# fqdn kb01 → kb01.poc.lab
fqdn() { echo "$1.$DOMAIN"; }
# host_port_list 9093 kc01 kc02 → kc01.poc.lab:9093,kc02.poc.lab:9093
host_port_list() {
  local port=$1 host list=""; shift
  for host in "$@"; do list+="${list:+,}$(fqdn "$host"):$port"; done
  echo "$list"
}
# 依角色取值：node_id_of kb01 → 101；rack_of kb01 → rack-a（非 controller／broker 回 0 和 -）
node_id_of() { local var="NODE_ID_${1//-/_}"; echo "${!var:-0}"; }
rack_of()    { local var="RACK_${1//-/_}";    echo "${!var:--}"; }

CONTROLLER_QUORUM=$(host_port_list 9093 $CONTROLLERS)   # controller.quorum.bootstrap.servers
BROKER_INTERNAL=$(host_port_list 9092 $BROKERS)         # INTERNAL listener（broker 之間、controller 上的 MDS client）
BROKER_TOKEN=$(host_port_list 9094 $BROKERS)            # TOKEN listener（C3、REST、操作機的管理 client）
BROKER_CLIENT=$(host_port_list 9095 $BROKERS)           # CLIENT listener（應用程式 SCRAM）
BROKER_LDAP=$(host_port_list 9096 $BROKERS)             # LDAP listener（人員 AD 帳密）
MDS_URLS=$(for host in $BROKERS; do printf 'https://%s:8090,' "$(fqdn "$host")"; done | sed 's/,$//')

FIRST_CONTROLLER=$(fqdn "${CONTROLLERS%% *}")   # 只需要連一台時用的那台（例如查 quorum）
FIRST_BROKER=$(fqdn "${BROKERS%% *}")
MDS_URL=https://$FIRST_BROKER:8090               # 只需要一個 MDS 網址時（confluent login、curl 檢查）
AD_FQDN=$(fqdn "$AD_HOST")
C3_FQDN=$(fqdn "$C3_HOST")
OPS_FQDN=$(fqdn "$OPS_HOST")

# client 連線設定（第 10、11 站產生）
INTERNAL_CLIENT_CONF=$CONF_DIR/client-internal.properties   # kafka-internal 憑證，連 controller（quorum 狀態）
ADMIN_CLIENT_CONF=$CONF_DIR/client-admin.properties         # svc-ops 憑證 → MDS token，連 TOKEN listener（管理作業）
ALICE_CLIENT_CONF=$CONF_DIR/client-alice.properties         # 測試人員 alice 的 AD 帳密，連 LDAP listener

# 應用程式清單（conf/apps.txt）
SCRAM_APPS=$(grep -v '^#' "$INSTALL_DIR/conf/apps.txt" | awk '$2=="scram"{print $1}' | paste -sd' ')  # 直連 Kafka 的 app
REST_APPS=$(grep -v '^#' "$INSTALL_DIR/conf/apps.txt" | awk '$2=="cert"{print $1}' | paste -sd'|')    # 走 REST Proxy 的 app（| 分隔，給 principal 對應規則用）
FIRST_REST_APP=${REST_APPS%%|*}      # REST 健康檢查用這個 app 的憑證
FIRST_SCRAM_APP=${SCRAM_APPS%% *}    # 驗收時扮演應用程式
# 用這個 app 的 client 憑證打 REST Proxy：rest_app_curl <curl 參數…>（本機直接用）
rest_app_curl() { curl --cert "$CERTS_DIR/$FIRST_REST_APP.crt" --key "$KEYS_DIR/$FIRST_REST_APP.key" "$@"; }
# 同樣的參數做成字串：要塞進送到別的 shell 的指令字串時用（lib/ssh.sh 的健康檢查、19 站的 check）
rest_app_curl_options() { echo "--cert $CERTS_DIR/$FIRST_REST_APP.crt --key $KEYS_DIR/$FIRST_REST_APP.key"; }

# 服務對應：屬於哪個 systemd 服務、設定檔在哪、服務帳號、啟動指令
unit_of() {
  case $1 in kc*|kb*) echo confluent-server;; rest*) echo confluent-kafka-rest;; c3*) echo confluent-control-center;; esac
}
props_path_of() {
  case $1 in kc*|kb*) echo /etc/confluent/kafka/server.properties;; rest*) echo /etc/confluent/kafka-rest/kafka-rest.properties;; c3*) echo /etc/confluent/control-center/control-center.properties;; esac
}
service_user_of() {
  case $1 in kc*|kb*) echo cp-kafka;; rest*) echo cp-kafka-rest;; c3*) echo cp-control-center;; esac
}
start_command_of() {
  case $1 in kc*|kb*) echo "/usr/bin/kafka-server-start /etc/confluent/kafka/server.properties";; rest*) echo "/usr/bin/kafka-rest-start /etc/confluent/kafka-rest/kafka-rest.properties";; c3*) echo "/usr/bin/control-center-start /etc/confluent/control-center/control-center.properties";; esac
}
